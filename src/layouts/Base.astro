---
import '../styles/global.css';
import Header from '../components/Header.astro';
import { site } from '../data/site';
import { aiit } from '../data/experience';
import { diploma } from '../data/education';

interface Props {
  /** Page-specific title; the home page uses "Name | Title". */
  title?: string;
  /** For pages that shouldn't be indexed (the 404 page). Also drops the canonical link. */
  noindex?: boolean;
}

const { title, noindex = false } = Astro.props;
const pageTitle = title ?? `${site.name} | ${site.title}`;

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.title,
  url: site.url,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Rawalpindi',
    addressCountry: 'PK',
  },
  worksFor: { '@type': 'Organization', name: aiit.org },
  alumniOf: { '@type': 'EducationalOrganization', name: diploma.school },
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: diploma.title,
    credentialCategory: 'Diploma',
    educationalLevel: diploma.level,
    dateCreated: diploma.end.iso,
    recognizedBy: { '@type': 'Organization', name: diploma.issuerName },
  },
  sameAs: [site.github, site.linkedin],
  knowsAbout: [
    'AWS',
    'Docker',
    'Kubernetes',
    'Terraform',
    'Ansible',
    'GitHub Actions',
    'Prometheus',
    'Grafana',
    'Linux',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={site.description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={site.url} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f5f3ee" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="preload" href="/fonts/geist-latin-wght.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={site.url} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={site.description} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_GB" />
    <meta property="profile:first_name" content="Syed Ali" />
    <meta property="profile:last_name" content="Hussain" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={site.description} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <script is:inline src="/theme.js"></script>
    <script is:inline src="/motion.js" defer></script>
    <script is:inline src="/carousel.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <footer class="wrap site-footer">
      <p>&copy; {new Date().getFullYear()} {site.name}</p>
    </footer>
  </body>
</html>

<style>
  .site-footer {
    padding-block: 3rem 2.5rem;
    color: var(--ink-2);
    font-size: var(--step--1);
  }
</style>
