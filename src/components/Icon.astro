---
interface Props {
  name: 'github' | 'linkedin' | 'mail' | 'download' | 'pin' | 'arrow' | 'chevron';
}

const { name } = Astro.props;
---

<svg
  class="icon"
  width="16"
  height="16"
  viewBox="0 0 16 16"
  aria-hidden="true"
  focusable="false"
>
  {
    name === 'github' && (
      <path
        fill="currentColor"
        d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
      />
    )
  }
  {
    name === 'linkedin' && (
      <path
        fill="currentColor"
        d="M13.63 0H2.37A2.37 2.37 0 000 2.37v11.26A2.37 2.37 0 002.37 16h11.26A2.37 2.37 0 0016 13.63V2.37A2.37 2.37 0 0013.63 0zM4.85 13.33H2.47V6h2.38v7.33zM3.66 5a1.38 1.38 0 110-2.76 1.38 1.38 0 010 2.76zm9.67 8.33h-2.37V9.77c0-.85-.02-1.94-1.18-1.94-1.19 0-1.37.92-1.37 1.88v3.62H6.04V6h2.28v1h.03c.32-.6 1.09-1.23 2.25-1.23 2.4 0 2.84 1.58 2.84 3.64v3.92z"
      />
    )
  }
  {
    name === 'mail' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <rect x="1.25" y="3" width="13.5" height="10" rx="1" />
        <path d="M1.5 3.5 8 9l6.5-5.5" />
      </g>
    )
  }
  {
    name === 'download' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 1.5v9M4.25 7 8 10.75 11.75 7M2 14.25h12" />
      </g>
    )
  }
  {
    name === 'pin' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round">
        <path d="M8 14.5s4.75-4.2 4.75-8.25a4.75 4.75 0 0 0-9.5 0C3.25 10.3 8 14.5 8 14.5z" />
        <circle cx="8" cy="6.25" r="1.75" />
      </g>
    )
  }
  {
    name === 'arrow' && (
      <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 11.5 11.5 4.5M5.5 4.5h6v6" />
      </g>
    )
  }
  {
    name === 'chevron' && (
      <path fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" d="m4 6 4 4 4-4" />
    )
  }
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
