---
import { sections } from '../data/site';
---

<header class="top">
  <div class="wrap top-inner">
    <a class="brand" href="/#top"><span class="mark" aria-hidden="true">SAH</span>syedalihussain.dev</a>
    <nav aria-label="Sections">
      <ul role="list">
        {
          sections.map((s) => (
            <li>
              <a href={`/#${s.id}`}>
                <span class="n">{s.n}</span>{' '}
                {s.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="toggle" type="button" data-theme-toggle hidden>Dark theme</button>
  </div>
</header>

<style>
  .top {
    border-bottom: 1px solid var(--rule);
    background: var(--bg);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .top-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand toggle'
      'nav nav';
    align-items: center;
    gap: 0.5rem 1.5rem;
    padding-block: 0.875rem;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }

  .mark {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--ink);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
  }

  nav {
    grid-area: nav;
    /* Lets the links scroll sideways on narrow phones instead of widening the page. */
    overflow-x: auto;
    margin-inline: calc(var(--gutter) * -1);
    /* Block padding leaves room for the focus outline, which overflow-x would otherwise clip. */
    padding: 0.375rem var(--gutter);
  }

  ul {
    display: flex;
    gap: 1.25rem;
    white-space: nowrap;
  }

  nav a {
    display: inline-block;
    padding-block: 0.375rem;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--accent);
  }

  .n {
    color: var(--accent);
  }

  .toggle {
    grid-area: toggle;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--rule);
    background: var(--surface);
    color: var(--ink-2);
    font: inherit;
    cursor: pointer;
  }

  .toggle:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  /* Hidden until theme.js wires it up, but keeps its space so nothing shifts. */
  .toggle[hidden] {
    display: block;
    visibility: hidden;
  }

  /* The single-row header needs ~58rem of content width; below that the nav gets its own row. */
  @media (min-width: 64rem) {
    .top-inner {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav toggle';
    }

    nav {
      justify-self: end;
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }
</style>
