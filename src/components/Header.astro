---
import Icon from './Icon.astro';
import { site, sections } from '../data/site';
import Link from './Link.astro';

const links = sections.filter((s) => s.nav).map((s) => ({ href: `/#${s.id}`, text: 'label' in s ? s.label : s.title }));
---

<header class="top">
  <div class="wrap bar">
    <Link class="brand" href="/#top">{site.name}</Link>

    <!-- Wide screens: the links inline. -->
    <nav class="inline" aria-label="Sections">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <Link href={l.href}>{l.text}</Link>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Phones: the same links in a <details> menu (no script). -->
    <details class="menu">
      <summary>Menu <Icon name="chevron" /></summary>
      <nav aria-label="Sections">
        <ul role="list">
          {
            links.map((l) => (
              <li>
                <Link href={l.href}>{l.text}</Link>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <button class="toggle" type="button" data-theme-toggle aria-label="Switch to light theme" hidden>
      {/* Shows the theme it switches to: a sun in dark mode, a moon in light mode. */}
      <svg class="sun" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <circle cx="9" cy="9" r="3.25"></circle>
          <path d="M9 1.5v1.75M9 14.75v1.75M1.5 9h1.75M14.75 9h1.75M3.7 3.7l1.24 1.24M13.06 13.06l1.24 1.24M3.7 14.3l1.24-1.24M13.06 4.94l1.24-1.24"></path>
        </g>
      </svg>
      <svg class="moon" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <path d="M14.75 11.1A6.25 6.25 0 0 1 6.9 3.25a6.25 6.25 0 1 0 7.85 7.85z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
      </svg>
    </button>
  </div>
</header>

<style>
  /* A slim bar that stays at the top while the page scrolls. */
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    font-size: 0.9375rem;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.5rem;
  }

  .brand {
    flex: none;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .inline,
  .menu {
    margin-left: auto;
  }

  ul {
    display: flex;
    white-space: nowrap;
  }

  nav a {
    display: inline-block;
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .inline ul {
    gap: 0.125rem;
  }

  /* Phones and small tablets: the inline links don't fit beside the full name, so they collapse
     into the menu. */
  .inline {
    display: none;
  }

  .menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .menu > summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] > summary :global(svg) {
    transform: rotate(180deg);
  }

  /* The open menu drops below the bar as a card, right-aligned with the gutter. */
  .menu > nav {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: var(--gutter);
    min-width: 12rem;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .menu ul {
    flex-direction: column;
  }

  .menu nav a {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    color: var(--ink);
  }

  /* The five links need ~760px beside the name and toggle; below 52rem they use the menu. */
  @media (min-width: 52rem) {
    .bar {
      gap: 1.5rem;
    }

    .inline {
      display: block;
    }

    .menu {
      display: none;
    }
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .toggle:hover {
    border-color: var(--ink-2);
  }

  /* Both icons share one spot; the one not in use is faded out and turned away. */
  .toggle svg {
    grid-area: 1 / 1;
  }

  .moon,
  :global([data-theme='light']) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global([data-theme='light']) .moon {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toggle svg {
      transition:
        opacity 200ms ease,
        transform 300ms var(--ease-out);
    }
  }

  /* Hidden until theme.js wires it up, but keeps its space so nothing shifts. */
  .toggle[hidden] {
    display: grid;
    visibility: hidden;
  }
</style>
