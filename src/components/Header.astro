---
import Icon from './Icon.astro';
import { site, sections } from '../data/site';

const links = sections.filter((s) => s.nav).map((s) => ({ href: `/#${s.id}`, text: 'label' in s ? s.label : s.title }));
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/#top">{site.name}</a>

    <!-- Wide screens: the links inline. -->
    <nav class="inline" aria-label="Sections">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.text}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Phones: the same links in a <details> menu (no script). -->
    <details class="menu">
      <summary>Menu <Icon name="chevron" /></summary>
      <nav aria-label="Sections">
        <ul role="list">
          {
            links.map((l) => (
              <li>
                <a href={l.href}>{l.text}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>

    <button class="toggle" type="button" data-theme-toggle hidden>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M9 2a7 7 0 0 1 0 14z" fill="currentColor"></path>
      </svg>
      <span class="sr-only" data-theme-label>Switch theme</span>
    </button>
  </div>
</header>

<style>
  /* A slim bar that stays at the top while the page scrolls. */
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    font-size: 0.9375rem;
  }

  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.5rem;
  }

  .brand {
    flex: none;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .inline,
  .menu {
    margin-left: auto;
  }

  ul {
    display: flex;
    white-space: nowrap;
  }

  nav a {
    display: inline-block;
    padding: 0.3125rem 0.75rem;
    border-radius: 999px;
    color: var(--ink-2);
    text-decoration: none;
  }

  nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  .inline ul {
    gap: 0.125rem;
  }

  /* Phones: the inline links don't fit beside the full name, so they collapse into the menu. */
  .inline {
    display: none;
  }

  .menu > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--ink);
    font-size: 0.875rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .menu > summary::-webkit-details-marker {
    display: none;
  }

  .menu[open] > summary :global(svg) {
    transform: rotate(180deg);
  }

  /* The open menu drops below the bar as a card, right-aligned with the gutter. */
  .menu > nav {
    position: absolute;
    top: calc(100% + 0.375rem);
    right: var(--gutter);
    min-width: 12rem;
    padding: 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .menu ul {
    flex-direction: column;
  }

  .menu nav a {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 8px;
    color: var(--ink);
  }

  @media (min-width: 40rem) {
    .bar {
      gap: 1.5rem;
    }

    .inline {
      display: block;
    }

    .menu {
      display: none;
    }
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .toggle:hover {
    border-color: var(--ink-2);
  }

  /* Hidden until theme.js wires it up, but keeps its space so nothing shifts. */
  .toggle[hidden] {
    display: grid;
    visibility: hidden;
  }
</style>
