---
import { site, sections } from '../data/site';

const links = sections.filter((s) => s.nav);
---

<header class="top">
  <div class="wrap bar">
    <a class="brand" href="/#top" aria-label={`${site.name}, back to top`}>
      <span class="mark" aria-hidden="true">SA</span><span class="name">{site.name}</span>
    </a>
    <nav aria-label="Sections">
      <ul role="list">
        {
          links.map((s) => (
            <li>
              <a href={`/#${s.id}`}>{'label' in s ? s.label : s.title}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <button class="toggle" type="button" data-theme-toggle hidden>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
        <circle cx="9" cy="9" r="7" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
        <path d="M9 2a7 7 0 0 1 0 14z" fill="currentColor"></path>
      </svg>
      <span class="sr-only" data-theme-label>Switch theme</span>
    </button>
  </div>
</header>

<style>
  /* A slim bar that stays at the top while the page scrolls. */
  .top {
    position: sticky;
    top: 0;
    z-index: 5;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    font-size: 0.9375rem;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 3.5rem;
  }

  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.625rem;
    color: var(--ink);
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 10px;
    background: var(--ink);
    color: var(--bg);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  /* Phones: the monogram stands in for the name so the four links fit. */
  .name {
    display: none;
  }

  @media (min-width: 48rem) {
    .name {
      display: inline;
    }
  }

  nav {
    min-width: 0;
    margin-left: auto;
    /* Scrolls sideways rather than widening the page if the links ever don't fit. */
    overflow-x: auto;
    scrollbar-width: none;
    /* Room for the focus outline, which overflow-x would otherwise clip. */
    padding-block: 0.25rem;
  }

  ul {
    display: flex;
    gap: 0.125rem;
    white-space: nowrap;
  }

  nav a {
    display: inline-block;
    padding: 0.3125rem 0.5rem;
    border-radius: 999px;
    color: var(--ink-2);
    font-size: 0.875rem;
    text-decoration: none;
  }

  nav a:hover {
    background: var(--surface-2);
    color: var(--ink);
  }

  nav a:focus-visible {
    outline-offset: -2px;
  }

  /* Small phones (360px): everything a little tighter so all four links fit beside the
     monogram and the toggle without scrolling. */
  @media (max-width: 29.99rem) {
    .bar {
      gap: 0.5rem;
    }

    .mark {
      width: 1.75rem;
      height: 1.75rem;
      border-radius: 8px;
      font-size: 0.6875rem;
    }

    .toggle {
      width: 2rem;
      height: 2rem;
    }

    ul {
      gap: 0;
    }

    nav a {
      padding-inline: 0.1875rem;
      font-size: 0.8125rem;
      letter-spacing: -0.01em;
    }
  }

  @media (min-width: 40rem) {
    .bar {
      gap: 1.5rem;
    }

    nav a {
      padding-inline: 0.75rem;
      font-size: 0.9375rem;
    }
  }

  .toggle {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .toggle:hover {
    border-color: var(--ink-2);
  }

  /* Hidden until theme.js wires it up, but keeps its space so nothing shifts. */
  .toggle[hidden] {
    display: grid;
    visibility: hidden;
  }
</style>
