---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import OrgBadge from './OrgBadge.astro';
import { site } from '../data/site';
import { aiit, change } from '../data/experience';
import Link from './Link.astro';

// The headshot at src/assets/img/ali.{jpg,jpeg,png,webp}, shown as a round avatar beside the
// name. astro:assets only optimises images imported from src/, so it can't live in public/.
// Without one the intro simply has no avatar.
const photos = import.meta.glob<ImageMetadata>('/src/assets/img/ali.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photo = Object.values(photos)[0];

// −53% -> 53: what motion.js counts up to.
const percent = (s: string) => s.replace(/\D/g, '');

const profiles = [
  { name: 'github', label: 'GitHub', url: site.github },
  { name: 'linkedin', label: 'LinkedIn', url: site.linkedin },
  { name: 'mail', label: `Email ${site.email}`, url: `mailto:${site.email}` },
] as const;
---

<section class="wrap hero" id="top" aria-labelledby="name">
  <div class="bento">
    <div class="card tile intro">
      {
        photo && (
          <div class="avatar">
            {/* The image is drawn 1.2× inside the circle so the face fills about 70% of it;
                sizes asks for that larger box (96px or 72px × 1.2), 2× candidates included. */}
            <Picture
              src={photo}
              formats={['avif', 'webp']}
              widths={[96, 144, 240]}
              sizes="(min-width: 40rem) 116px, 87px"
              alt={site.name}
              loading="eager"
            />
          </div>
        )
      }
      <div class="head">
        <p class="pill ok"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
        <h1 id="name">{site.name}</h1>
        <p class="role">{site.title}</p>
      </div>
      <div class="body">
        <p class="summary">{site.summary}</p>
        <p class="focus">{site.focus}</p>
        <ul class="actions" role="list">
          <li><Link class="btn primary" href={site.cv}><Icon name="download" />Download CV</Link></li>
          <li><Link class="btn" href="#contact"><Icon name="mail" />Contact</Link></li>
        </ul>
      </div>
      <div class="aside">
        <p class="place"><Icon name="pin" />{site.location}</p>
        <ul class="socials" role="list">
          {
            profiles.map((p) => (
              <li>
                <Link href={p.url} aria-label={p.label}>
                  <Icon name={p.name} />
                </Link>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="card tile now" data-reveal data-step="1">
      <p class="eyebrow">Currently</p>
      <div class="org">
        <OrgBadge name={aiit.org} initials="AIIT" logo="aiit" />
        <div>
          <p class="value">{aiit.role}</p>
          <p class="sub">{aiit.org}</p>
        </div>
      </div>
      <p class="sub since">Since {aiit.start.label} · {aiit.location}</p>
    </div>

    {
      aiit.results.map((r, i) => (
        <div class="card tile stat" data-reveal data-step={String(i + 2)}>
          <p class="eyebrow">{r.metric}</p>
          <p class="big" aria-hidden="true">
            <span data-count={percent(change(r))} data-prefix="−" data-suffix="%">{change(r)}</span>
          </p>
          <p class="sub" aria-hidden="true">
            {r.before.label} → {r.after.label}
          </p>
          <p class="sr-only">
            Down {percent(change(r))} percent, from {r.before.label} to {r.after.label}.
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 3vw, 2rem) 0;
  }

  .bento {
    display: grid;
    gap: var(--gap);
  }

  .tile {
    padding: clamp(1.125rem, 2.5vw, 1.5rem);
  }

  /* Intro: avatar, name block, summary and actions, then location and profile links.
     Phones stack these; from 40rem the avatar sits left of the name. */
  .intro {
    display: grid;
    grid-template-areas:
      'avatar'
      'head'
      'body'
      'aside';
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .avatar {
    grid-area: avatar;
    width: 72px;
    height: 72px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface-2);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.2);
    transform-origin: 50% 28%;
  }

  .head {
    grid-area: head;
    display: grid;
    justify-items: start;
    align-content: center;
  }

  h1 {
    margin-top: 0.875rem;
    font-size: clamp(2.375rem, 1.4rem + 4vw, 4.25rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .role {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .body {
    grid-area: body;
  }

  .summary {
    max-width: 36rem;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .focus {
    margin-top: 0.875rem;
    color: var(--ink-2);
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.75rem;
  }

  .aside {
    grid-area: aside;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .place {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  .socials a:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }

  @media (min-width: 40rem) {
    .intro {
      grid-template-columns: 96px minmax(0, 1fr);
      grid-template-areas:
        'avatar head'
        '. body'
        '. aside';
      column-gap: 1.75rem;
    }

    /* No headshot: the text starts at the tile's edge. */
    .intro:not(:has(.avatar)) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'body'
        'aside';
    }

    .avatar {
      width: 96px;
      height: 96px;
      align-self: center;
    }
  }

  /* Desktop: location and links move to a right-hand column, level with the actions. */
  @media (min-width: 64rem) {
    .intro {
      grid-template-columns: 96px minmax(0, 1fr) auto;
      grid-template-areas:
        'avatar head head'
        '. body aside';
    }

    .intro:not(:has(.avatar)) {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head head'
        'body aside';
    }

    .aside {
      flex-direction: column;
      align-items: flex-end;
      align-self: end;
      padding-top: 0;
      border-top: 0;
    }
  }

  /* Small tiles: an eyebrow, a value, a line of detail. */
  .now,
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .org {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .value {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .sub {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .since {
    margin-top: auto;
  }

  .big {
    color: var(--accent);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.25rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* Phones: each stat puts its number beside its label, so the hero stays short. */
  @media (max-width: 39.99rem) {
    .stat {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'big eyebrow'
        'big sub';
      align-items: center;
      gap: 0.125rem 1rem;
    }

    .stat .eyebrow {
      grid-area: eyebrow;
      align-self: end;
    }

    .stat .big {
      grid-area: big;
      min-width: 5.5ch;
    }

    .stat .sub {
      grid-area: sub;
      align-self: start;
    }
  }

  /* Wide "Currently" tile: the dates move up beside the role. Stats sit three to a row. */
  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .intro,
    .now {
      grid-column: 1 / -1;
    }

    .now {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'eyebrow eyebrow'
        'org since';
      align-items: center;
    }

    .now .eyebrow {
      grid-area: eyebrow;
    }

    .now .org {
      grid-area: org;
    }

    .since {
      grid-area: since;
      margin-top: 0;
      text-align: right;
    }
  }
</style>
