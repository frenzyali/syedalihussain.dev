---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import OrgBadge from './OrgBadge.astro';
import { site } from '../data/site';
import { aiit, change } from '../data/experience';

// The headshot, if one has been added at src/assets/img/ali.{jpg,jpeg,png,webp}. astro:assets
// only optimises images imported from src/, so it can't live in public/. Without one the card
// shows just the location and links.
const photos = import.meta.glob<ImageMetadata>('/src/assets/img/ali.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const photo = Object.values(photos)[0];

// −53% -> 53: what motion.js counts up to.
const percent = (s: string) => s.replace(/\D/g, '');

const profiles = [
  { name: 'github', label: 'GitHub', url: site.github },
  { name: 'linkedin', label: 'LinkedIn', url: site.linkedin },
  { name: 'mail', label: `Email ${site.email}`, url: `mailto:${site.email}` },
] as const;
---

<section class="wrap hero" id="top" aria-labelledby="name">
  <div class="bento">
    <div class="card tile intro">
      <p class="pill ok"><span class="dot" aria-hidden="true"></span>{site.availability}</p>
      <h1 id="name">{site.name}</h1>
      <p class="role">{site.title}</p>
      <p class="summary">{site.summary}</p>
      <p class="focus">{site.focus}</p>
      <ul class="actions" role="list">
        <li><a class="btn primary" href={site.cv} download><Icon name="download" />Download CV</a></li>
        <li><a class="btn" href="#contact"><Icon name="mail" />Contact</a></li>
      </ul>
    </div>

    <div class="card tile profile" data-reveal data-step="1">
      {
        photo ? (
          <Picture
            class="photo"
            src={photo}
            formats={['avif', 'webp']}
            widths={[208, 320, 480, 720]}
            sizes="(min-width: 64rem) 22rem, (min-width: 40rem) 30vw, 6.5rem"
            alt={`${site.name}, headshot`}
            loading="eager"
          />
        ) : null
      }
      <div class="profile-text">
        <p class="profile-place"><Icon name="pin" />{site.location}</p>
        <ul class="socials" role="list">
          {
            profiles.map((p) => (
              <li>
                <a href={p.url} aria-label={p.label}>
                  <Icon name={p.name} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="card tile now" data-reveal data-step="2">
      <p class="eyebrow">Currently</p>
      <div class="org">
        <OrgBadge initials="AIIT" logo="aiit" />
        <div>
          <p class="value">{aiit.role}</p>
          <p class="sub">{aiit.org}</p>
        </div>
      </div>
      <p class="sub since">Since {aiit.start.label} · {aiit.location}</p>
    </div>

    {
      aiit.results.map((r, i) => (
        <div class="card tile stat" data-reveal data-step={String(i + 2)}>
          <p class="eyebrow">{r.metric}</p>
          <p class="big" aria-hidden="true">
            <span data-count={percent(change(r))} data-prefix="−" data-suffix="%">{change(r)}</span>
          </p>
          <p class="sub" aria-hidden="true">
            {r.before.label} → {r.after.label}
          </p>
          <p class="sr-only">
            Down {percent(change(r))} percent, from {r.before.label} to {r.after.label}.
          </p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1rem, 3vw, 2rem) 0;
  }

  .bento {
    display: grid;
    gap: var(--gap);
  }

  .tile {
    padding: clamp(1.125rem, 2.5vw, 1.5rem);
  }

  /* Intro: name, role, summary, actions. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  h1 {
    margin-top: 1.5rem;
    font-size: clamp(2.375rem, 1.4rem + 4vw, 4.25rem);
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .role {
    margin-top: 0.5rem;
    color: var(--ink-2);
    font-size: var(--step-1);
    font-weight: 500;
  }

  .summary {
    max-width: 36rem;
    margin-top: 1.25rem;
    font-size: var(--step-1);
    line-height: 1.55;
  }

  .focus {
    margin-top: 0.875rem;
    color: var(--ink-2);
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: auto;
    padding-top: 2rem;
  }

  /* Profile: headshot (if any), location and profile links. The name and role are in the intro. */
  .profile {
    display: flex;
    flex-direction: column;
    gap: 1.125rem;
    padding: 0.625rem 0.625rem 1.25rem;
  }

  .photo {
    width: 100%;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 8px);
    object-fit: cover;
  }


  .profile-text {
    display: grid;
    justify-items: center;
    gap: 0.125rem;
    padding-inline: 0.75rem;
    text-align: center;
  }

  .profile-place {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .socials {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.875rem;
  }

  .socials a {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
  }

  .socials a:hover {
    border-color: var(--line-strong);
    background: var(--surface-2);
  }

  /* Small tiles: an eyebrow, a value, a line of detail. */
  .now,
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .org {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .value {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .sub {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .since {
    margin-top: auto;
  }

  /* Wide "Currently" tile: the dates move up beside the role. */
  @media (min-width: 40rem) {
    .now {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'eyebrow eyebrow'
        'org since';
      align-items: center;
    }

    .now .eyebrow {
      grid-area: eyebrow;
    }

    .now .org {
      grid-area: org;
    }

    .since {
      grid-area: since;
      margin-top: 0;
      text-align: right;
    }
  }

  .big {
    color: var(--accent);
    font-size: clamp(2.5rem, 2rem + 2vw, 3.25rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  /* Phones: the profile is a row (small photo beside the text) and each stat puts its number
     beside its label, so the hero stays short. */
  @media (max-width: 39.99rem) {
    .profile {
      display: grid;
      grid-template-columns: 6.5rem minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
      padding: 0.625rem;
    }

    /* No headshot: the location and links take the whole row. */
    .profile:not(:has(picture)) {
      grid-template-columns: minmax(0, 1fr);
      padding: 1rem;
    }


    .profile-text {
      justify-items: start;
      padding-inline: 0;
      text-align: left;
    }

    .socials {
      margin-top: 0.5rem;
    }

    .stat {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'big eyebrow'
        'big sub';
      align-items: center;
      gap: 0.125rem 1rem;
    }

    .stat .eyebrow {
      grid-area: eyebrow;
      align-self: end;
    }

    .stat .big {
      grid-area: big;
      min-width: 5.5ch;
    }

    .stat .sub {
      grid-area: sub;
      align-self: start;
    }
  }

  /* Tablet: intro across the top; profile beside the two info tiles; stats in a row. */
  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .intro {
      grid-column: 1 / -1;
    }

    .profile {
      grid-column: 1 / 3;
    }

    .now {
      grid-column: 3 / -1;
    }

    .stat {
      grid-column: span 2;
    }
  }

  /* Desktop: intro (2 rows) and the info tiles on the left, the profile tall on the right. */
  @media (min-width: 64rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .intro {
      grid-column: 1 / 9;
      grid-row: 1 / 3;
    }

    .profile {
      grid-column: 9 / -1;
      grid-row: 1 / 4;
    }

    /* The photo fills whatever height the tall tile has left; positioned absolutely so it
       never sets the row heights (no layout shift while it loads). */
    .profile > picture {
      position: relative;
      flex: 1;
      min-height: 18rem;
    }

    .profile > picture .photo {
      position: absolute;
      inset: 0;
      height: 100%;
      aspect-ratio: auto;
      object-position: 50% 25%;
    }

    .now {
      grid-column: 1 / 9;
      grid-row: 3;
    }

    .stat {
      grid-column: span 4;
    }
  }
</style>
