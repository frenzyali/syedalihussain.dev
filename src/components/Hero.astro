---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { aiit } from '../data/experience';
---

<section class="wrap hero" id="top" aria-labelledby="name">
  <div class="frame">
    <span class="corner tl" aria-hidden="true"></span>
    <span class="corner tr" aria-hidden="true"></span>
    <span class="corner bl" aria-hidden="true"></span>
    <span class="corner br" aria-hidden="true"></span>
    <div class="hero-main">
      <h1 id="name">{site.name}</h1>
      <p class="summary">{site.summary}</p>
      <ul class="actions" role="list">
        <li><a class="btn primary" href={site.cv} download><Icon name="download" />Download CV</a></li>
        <li><a class="btn" href={site.github}><Icon name="github" />GitHub</a></li>
        <li><a class="btn" href="#contact"><Icon name="mail" />Contact</a></li>
      </ul>
    </div>
    <dl class="titleblock">
      <div><dt>role</dt><dd>{site.title}</dd></div>
      <div><dt>location</dt><dd>{site.location}</dd></div>
      <div><dt>employer</dt><dd>{aiit.org}</dd></div>
      <div><dt>since</dt><dd>{aiit.start.label}</dd></div>
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2rem, 6vw, 4.5rem);
  }

  /* A drawing frame with registration corners and a title block. */
  .frame {
    position: relative;
    display: grid;
    gap: 2.5rem;
    padding: clamp(1.25rem, 4vw, 3rem);
    border: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 82%, transparent);
  }

  .corner {
    position: absolute;
    width: 14px;
    height: 14px;
    border: 0 solid var(--accent);
  }

  .tl {
    top: -5px;
    left: -5px;
    border-top-width: 2px;
    border-left-width: 2px;
  }

  .tr {
    top: -5px;
    right: -5px;
    border-top-width: 2px;
    border-right-width: 2px;
  }

  .bl {
    bottom: -5px;
    left: -5px;
    border-bottom-width: 2px;
    border-left-width: 2px;
  }

  .br {
    bottom: -5px;
    right: -5px;
    border-bottom-width: 2px;
    border-right-width: 2px;
  }

  h1 {
    font-family: var(--display);
    font-size: clamp(3rem, 1.5rem + 6.5vw, 6.25rem);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.01em;
  }

  .summary {
    max-width: 34rem;
    margin-top: 1.75rem;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .titleblock {
    align-self: end;
    display: grid;
    border: 1px solid var(--ink);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .titleblock div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
  }

  .titleblock div + div {
    border-top: 1px solid var(--rule);
  }

  .titleblock dt {
    padding: 0.5rem 0.75rem;
    border-right: 1px solid var(--rule);
    color: var(--ink-2);
  }

  .titleblock dd {
    padding: 0.5rem 0.75rem;
    font-weight: 600;
  }

  @media (min-width: 60rem) {
    .frame {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: end;
    }
  }
</style>
