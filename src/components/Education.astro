---
import Section from './Section.astro';
import OrgBadge from './OrgBadge.astro';
import Icon from './Icon.astro';
import { diploma, school, certifications } from '../data/education';
import Link from './Link.astro';
---

<Section id="education">
  <article class="card diploma" data-reveal aria-labelledby="diploma-title">
    <div class="head">
      <OrgBadge name={diploma.issuerName} initials="EQ" logo="eduqual" size={56} />
      <div class="titles">
        <h3 id="diploma-title">{diploma.title}</h3>
        <p class="sub">{diploma.level}</p>
        <p class="sub">{diploma.school}</p>
        <p class="pill ok status"><span class="dot" aria-hidden="true"></span>Completed</p>
      </div>
    </div>

    <div class="grade">
      <p class="big" aria-hidden="true">
        <span data-count={diploma.grade.score} data-suffix="%">{diploma.grade.score}%</span>
      </p>
      <p class="grade-label" aria-hidden="true">{diploma.grade.label}</p>
      <p class="sr-only">Grade: {diploma.grade.label}, {diploma.grade.score}%.</p>
    </div>

    <dl class="facts">
      <div>
        <dt>Issuer</dt>
        <dd>{diploma.issuer}</dd>
      </div>
      <div>
        <dt>Dates</dt>
        <dd>
          <time datetime={diploma.start.iso}>{diploma.start.label}</time> –{' '}
          <time datetime={diploma.end.iso}>{diploma.end.label}</time>
        </dd>
      </div>
      <div>
        <dt>Final project</dt>
        <dd>{diploma.project}</dd>
      </div>
    </dl>

    <details class="more foot">
        <summary>
          <span class="when-closed">Show units ({diploma.units.length})</span><span class="when-open">Hide units</span>
          <Icon name="chevron" />
        </summary>
        <ul class="chips" role="list" aria-label="Units">
          {diploma.units.map((u) => <li>{u}</li>)}
        </ul>
    </details>
  </article>

  <div class="card school" data-reveal>
    <OrgBadge name={school.board} initials="BIEK" logo="biek" />
    <div class="titles">
      <h3>{school.title}</h3>
      <p class="sub">{school.board}</p>
    </div>
    <p class="school-meta">
      <span class="pill"><time datetime={school.year}>{school.year}</time></span>
      <span class="pill">{school.grade}</span>
    </p>
  </div>

  <h3 class="group-title">Certifications</h3>
  <ul class="certs" role="list">
    {
      certifications.map((c, i) => (
        <li class="card cert" data-reveal data-step={String(i)}>
          <OrgBadge name={c.issuer} initials={c.initials} logo={c.logo} />
          <div class="titles">
            <h4>{c.title}</h4>
            <p class="sub">{c.issuer}</p>
            <div class="cert-foot">
              {c.url ? (
                <Link class="verify" href={c.url}>
                  Verify <Icon name="arrow" />
                </Link>
              ) : (
                <p class="pill pending">
                  <span class="dot" aria-hidden="true" />
                  In progress
                </p>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .titles {
    min-width: 0;
  }

  h3,
  h4 {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .sub {
    margin-top: 0.125rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  /* Diploma: head and facts on the left, the grade as a stat on the right. */
  .diploma {
    display: grid;
    grid-template-areas:
      'head'
      'grade'
      'facts'
      'foot';
    gap: 1.25rem;
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  .head {
    grid-area: head;
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  /* Phones: the wide EduQual badge sits above the title instead of squeezing it. */
  @media (max-width: 39.99rem) {
    .head:has(:global(.wide)) {
      flex-direction: column;
    }
  }

  .diploma h3 {
    font-size: clamp(1.1875rem, 1rem + 0.8vw, 1.5rem);
    letter-spacing: -0.02em;
  }

  .grade {
    grid-area: grade;
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .big {
    color: var(--accent);
    font-size: clamp(3rem, 2.25rem + 3vw, 4.5rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .grade-label {
    color: var(--ink-2);
    font-weight: 500;
  }

  .facts {
    grid-area: facts;
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  .facts div {
    display: grid;
    gap: 0.125rem;
  }

  dt {
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .foot {
    grid-area: foot;
    margin-top: 0;
  }

  .status {
    margin-top: 0.5rem;
  }

  @media (min-width: 48rem) {
    .diploma {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'head grade'
        'facts grade'
        'foot foot';
      column-gap: 2.5rem;
    }

    .grade {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.375rem;
      text-align: right;
    }

    .facts div {
      grid-template-columns: 7.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    dt {
      padding-top: 0.2rem;
    }
  }

  /* HSSC: one compact row. */
  .school {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem 0.875rem;
    margin-top: var(--gap);
    padding: 1rem 1.25rem;
  }

  .school-meta {
    grid-column: 1 / -1;
    display: flex;
    gap: 0.375rem;
  }

  @media (min-width: 48rem) {
    .school {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .school-meta {
      grid-column: 3;
    }
  }

  .group-title {
    margin: 2rem 0 0.875rem;
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .certs {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 48rem) {
    .certs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cert {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.25rem;
  }

  .cert .titles {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .cert-foot {
    margin-top: auto;
    padding-top: 1rem;
  }

  .verify {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-weight: 500;
  }
</style>
