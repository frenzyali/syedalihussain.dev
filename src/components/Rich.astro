---
// Renders a string where `backticked` words are tool names, set slightly heavier (.tool).
interface Props {
  text: string;
}

const parts = Astro.props.text.split('`');
if (parts.length % 2 === 0) throw new Error(`Rich: unbalanced backtick in "${Astro.props.text}"`);
---

{parts.map((part, i) => (i % 2 ? <span class="tool">{part}</span> : part))}
