---
import Section from './Section.astro';
import TechIcon from './TechIcon.astro';
import Icon from './Icon.astro';
import { core, groups } from '../data/skills';
---

<Section id="skills">
  <div class="card skills" data-reveal>
    <ul class="icons" role="list" aria-label="Main tools">
      {
        core.map((s) => (
          <li>
            <TechIcon slug={s.icon} text={s.badge} size={32} />
            <span class="name">{s.name}</span>
          </li>
        ))
      }
    </ul>

    <details class="more">
      <summary>
        <span class="when-closed">Show all skills</span><span class="when-open">Show fewer</span>
        <Icon name="chevron" />
      </summary>
      <div class="groups">
        {
          groups.map((g) => (
            <div class="group">
              <h3>{g.name}</h3>
              <ul class="chips" role="list">
                {g.items.map((s) => (
                  <li>
                    <TechIcon slug={s.icon} text={s.badge} size={14} />
                    <span>
                      {s.name}
                      {s.detail && <span class="detail">: {s.detail}</span>}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </details>
  </div>
</Section>

<style>
  .skills {
    padding: clamp(1.25rem, 4vw, 2rem);
  }

  /* The icon grid: one consistent cell per tool, the name always visible. */
  .icons {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .icons li {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 0.625rem;
    min-height: 6.5rem;
    padding: 0.875rem 0.375rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-align: center;
  }

  .name {
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.3;
  }

  @media (min-width: 40rem) {
    .icons {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .icons {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  .groups {
    display: grid;
    gap: 1.25rem 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 48rem) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  h3 {
    margin-bottom: 0.5rem;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chips li {
    padding-left: 0.5rem;
  }

  .detail {
    color: var(--ink-2);
  }

  /* Text badges inside chips shrink to the 14px icon size. */
  .chips :global(.ti-text) {
    min-width: 14px;
    height: 14px;
    border-radius: 3px;
    font-size: 0.4375rem;
  }
</style>
