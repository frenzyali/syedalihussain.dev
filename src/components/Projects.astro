---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// Descriptions state only what each repo's README shows.
const featured = [
  {
    repo: 'aws-terraform-3tier',
    status: { state: 'pending', label: 'validated in CI, not yet applied' },
    text: 'A 3-tier AWS environment in modular Terraform: a VPC across two availability zones, ALB, Auto Scaling Group and RDS MySQL, with S3 remote state and DynamoDB locking. CI runs fmt, validate, tflint and checkov. It has not yet been applied to a real AWS account.',
    stack: ['Terraform', 'AWS', 'Secrets Manager', 'tflint', 'checkov', 'GitHub Actions'],
  },
  {
    repo: 'observability-stack',
    status: { state: 'ok', label: 'tested in CI' },
    text: 'Prometheus, Alertmanager and Grafana on Docker Compose, with dashboards and alerts as code. All 13 alert rules are unit-tested with promtool, SLO burn-rate alerts follow the Google SRE Workbook, and CI breaks a sample app to prove the alerts fire, route and resolve.',
    stack: ['Prometheus', 'Alertmanager', 'Grafana', 'Docker Compose', 'Python', 'Trivy'],
  },
  {
    repo: 'ansible-linux-hardening',
    status: { state: 'ok', label: 'tested in CI' },
    text: 'Eight idempotent Ansible roles that harden Ubuntu 24.04 and Rocky Linux 9: SSH, users, firewall, fail2ban, kernel, auditd and updates. Molecule runs every role in CI, plus a scenario proving the SSH lockout guard refuses unsafe configs.',
    stack: ['Ansible', 'Molecule', 'Docker', 'ansible-lint', 'GitHub Actions'],
  },
];

const earlier = [
  {
    repo: 'reddit-clone-k8s',
    text: 'Next.js app on Kubernetes: a 2-replica Deployment with probes and limits, a NodePort Service and an optional Ingress. kubeconform validates the manifests in CI.',
  },
  {
    repo: 'Automated-Deployment-With-S3-Logs',
    text: 'Dockerized Python app deployed to EC2 by a Jenkins pipeline over SSH, with container logs shipped to S3 hourly by cron.',
  },
];

const url = (repo: string) => `${site.github}/${repo}`;
---

<Section id="projects">
  <ul class="cards" role="list">
    {
      featured.map((p) => (
        <li class="card">
          <h3>
            <a href={url(p.repo)}>
              <Icon name="github" />
              {p.repo}
            </a>
          </h3>
          <p class:list={['status', p.status.state]}>
            <span class="dot" aria-hidden="true" />
            {p.status.label}
          </p>
          <p class="text">{p.text}</p>
          <ul class="stack" role="list" aria-label="Stack">
            {p.stack.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <h3 class="earlier-title">Earlier projects</h3>
  <ul class="earlier" role="list">
    {
      earlier.map((p) => (
        <li>
          <a href={url(p.repo)}>{p.repo}</a>
          <p>{p.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    gap: 1px;
    border: 1px solid var(--rule);
    background: var(--rule);
  }

  @media (min-width: 64rem) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* The repo link stretches over the whole card, so the card is one click target. */
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.125rem 1.125rem 1.25rem;
    background: var(--surface);
    transition: background-color 150ms ease;
  }

  .card:hover,
  .card:focus-within {
    background: color-mix(in srgb, var(--surface) 92%, var(--accent));
  }

  .card h3 {
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .card h3 a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink);
    text-decoration: none;
  }

  .card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover h3 a {
    color: var(--accent);
    text-decoration: underline;
  }

  .card h3 a:focus-visible {
    outline: none;
  }

  .card:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.5rem;
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .status.ok {
    color: var(--ok);
  }

  .status.pending {
    color: var(--pending);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .text {
    margin-top: 0.875rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: auto;
    padding-top: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .earlier-title {
    margin-top: 2.5rem;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: var(--step--1);
    font-weight: 600;
  }

  .earlier {
    margin-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .earlier li {
    display: grid;
    gap: 0.25rem 2rem;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--rule);
  }

  .earlier a {
    font-family: var(--mono);
    font-size: 0.9375rem;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .earlier p {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  @media (min-width: 52rem) {
    .earlier li {
      grid-template-columns: 22rem minmax(0, 1fr);
    }
  }
</style>
