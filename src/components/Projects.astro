---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { featured, earlier } from '../data/projects';
import Link from './Link.astro';

const url = (repo: string) => `${site.github}/${repo}`;
---

<Section id="projects">
  <ul class="grid featured" role="list">
    {
      featured.map((p, i) => (
        <li class="card project lift" data-reveal data-step={String(i)}>
          <div class="head">
            <Icon name="github" />
            <h3>
              <Link href={url(p.repo)}>{p.repo}</Link>
            </h3>
            <span class="go" aria-hidden="true">
              <Icon name="arrow" />
            </span>
          </div>
          <p class="pill">{p.ci}</p>
          <p class="text">{p.text}</p>
          <ul class="chips" role="list" aria-label="Stack">
            {p.stack.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </li>
      ))
    }
  </ul>

  <h3 class="earlier-title">Earlier projects</h3>
  <ul class="grid earlier" role="list">
    {
      earlier.map((p, i) => (
        <li class="card project lift" data-reveal data-step={String(i)}>
          <div class="head">
            <Icon name="github" />
            <h4>
              <Link href={url(p.repo)}>{p.repo}</Link>
            </h4>
            <span class="go" aria-hidden="true">
              <Icon name="arrow" />
            </span>
          </div>
          <p class="text">{p.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .grid {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 40rem) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .featured > li:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .featured {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .featured > li:last-child {
      grid-column: auto;
    }
  }

  /* The repo link stretches over the whole card, so the card is one click target. */
  .project {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    padding: 1.25rem;
  }

  .head {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
  }

  h3,
  h4 {
    min-width: 0;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .head a {
    color: var(--ink);
    text-decoration: none;
  }

  .head a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .head a:focus-visible {
    outline: none;
  }

  .project:has(a:focus-visible) {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .go {
    display: grid;
    place-items: center;
    flex: none;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink-2);
  }

  .project:hover .go {
    background: var(--accent);
    color: var(--accent-ink);
  }

  .project:hover .head a {
    color: var(--accent);
  }

  .text {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .chips {
    margin-top: auto;
    padding-top: 0.25rem;
  }

  .earlier-title {
    margin: 2rem 0 0.875rem;
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
  }

  .earlier h4 {
    font-size: 1rem;
  }
</style>
