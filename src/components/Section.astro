---
import { sections } from '../data/site';

interface Props {
  id: (typeof sections)[number]['id'];
}

const section = sections.find((s) => s.id === Astro.props.id);
if (!section) throw new Error(`Section: unknown id "${Astro.props.id}" (see sections in src/data/site.ts)`);
const { n, title, id } = section;
---

<section class="wrap section" id={id} aria-labelledby={`${id}-title`} data-reveal>
  <h2 id={`${id}-title`}><span class="n">{n}</span>{' '}{title}</h2>
  <slot />
</section>

<style>
  .section {
    padding-block: 2.5rem 3rem;
    scroll-margin-top: 1rem;
  }

  /* Number, title, then a connector line running to the edge. */
  h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.5rem;
    font-family: var(--mono);
    font-size: var(--step-0);
    font-weight: 600;
  }

  .n {
    padding: 0.125rem 0.375rem;
    background: var(--accent);
    color: var(--accent-ink);
  }

  h2::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rule);
  }
</style>
