---
import { sections } from '../data/site';

interface Props {
  id: (typeof sections)[number]['id'];
}

const section = sections.find((s) => s.id === Astro.props.id);
if (!section) throw new Error(`Section: unknown id "${Astro.props.id}" (see sections in src/data/site.ts)`);
const { title, id } = section;
---

<section class="wrap section" id={id} aria-labelledby={`${id}-title`}>
  <h2 id={`${id}-title`}>{title}</h2>
  <slot />
</section>

<style>
  .section {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) 0;
  }

  h2 {
    margin-bottom: 1.25rem;
    font-size: clamp(1.625rem, 1.2rem + 1.4vw, 2.25rem);
  }
</style>
