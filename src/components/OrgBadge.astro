---
// An organisation's logo, or a neutral initials badge until the logo exists at
// public/img/logos/<logo>.webp. The WebPs are made by scripts/logos.py from the official files in
// assets-src/logos/: trimmed and flattened onto white, so every logo sits on the same white tile
// in both themes.
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** Organisation name, used as the logo's alt text. */
  name: string;
  initials: string;
  /** File name without extension in public/img/logos/. */
  logo?: string;
}

const { name, initials, logo } = Astro.props;
const src = logo && existsSync(join(process.cwd(), 'public/img/logos', `${logo}.webp`)) ? `/img/logos/${logo}.webp` : undefined;
---

{
  src ? (
    <img class="badge logo" src={src} width="44" height="44" alt={name} decoding="async" />
  ) : (
    <span class="badge initials" aria-hidden="true">
      {initials}
    </span>
  )
}
<style>
  .badge {
    flex: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface);
    object-fit: contain;
  }

  /* The logo files already carry their white tile and margin; this only rounds and outlines it. */
  .logo {
    background: var(--logo-tile);
    object-fit: contain;
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 650;
    letter-spacing: 0.02em;
  }
</style>
