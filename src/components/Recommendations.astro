---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { recommendations, recommendationsUrl } from '../data/recommendations';
import Link from './Link.astro';

const initials = (name: string) =>
  name
    .split(' ')
    .filter((w) => /^[A-Z]/.test(w))
    .map((w) => w[0])
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .join('');

// The strip holds the cards twice, so translating it by half loops without a jump. The second
// set is for the eye only: hidden from screen readers and out of the tab order.
const sets = [false, true];
---

<Section id="recommendations">
  <div class="marquee" data-marquee>
    <div class="viewport">
      <ul class="track" role="list">
        {
          sets.map((copy) =>
            recommendations.map((r) => (
              <li class="card rec" aria-hidden={copy ? 'true' : undefined}>
                <span class="mark" aria-hidden="true">
                  “
                </span>
                <p class="pull" aria-hidden="true">
                  {r.pull}
                </p>
                <blockquote class="text">
                  <p>{r.text}</p>
                </blockquote>
                <footer class="who">
                  <span class="initials" aria-hidden="true">
                    {initials(r.name)}
                  </span>
                  <div class="who-text">
                    <p class="name">{r.name}</p>
                    <p class="title">{r.title}</p>
                    <p class="meta">
                      {r.relationship} · <time datetime={r.date.iso}>{r.date.label}</time>
                    </p>
                  </div>
                </footer>
                {/* Covers the card: click or Enter opens the full text in the dialog (carousel.js). */}
                <button class="open" type="button" data-open aria-haspopup="dialog" tabindex={copy ? -1 : undefined}>
                  <span class="sr-only">Read the full recommendation from {r.name}</span>
                </button>
              </li>
            ))
          )
        }
      </ul>
    </div>

    <div class="controls">
      {/* Laid out but invisible until carousel.js wires them up, so nothing shifts. */}
      <div class="buttons">
        {/* One accessible name, with aria-pressed for the state; the visible text and icon show
            what pressing it does next. */}
        <button class="pause" type="button" data-pause aria-pressed="false" aria-label="Pause recommendations">
          <span class="when-playing" aria-hidden="true"><Icon name="pause" />Pause</span>
          <span class="when-paused" aria-hidden="true"><Icon name="play" />Play</span>
        </button>
        <button class="arrow" type="button" data-dir="-1" aria-label="Previous recommendation">
          <Icon name="chevron" />
        </button>
        <button class="arrow next" type="button" data-dir="1" aria-label="Next recommendation">
          <Icon name="chevron" />
        </button>
      </div>
      <Link class="more-link" href={recommendationsUrl}>Read on LinkedIn <span aria-hidden="true">→</span></Link>
    </div>

    <dialog class="rec-dialog" aria-labelledby="rec-dialog-name">
      <button class="close" type="button" data-close aria-label="Close">
        <Icon name="close" />
      </button>
      <div class="dialog-body" data-body></div>
    </dialog>
  </div>
</Section>

<style>
  /* The strip: cards in a row, faded out at both edges. */
  .viewport {
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
  }

  /* Each card carries its own right margin (not a flex gap), so one set is exactly half the strip. */
  .rec {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 280px;
    margin-right: var(--gap);
    padding: 1.5rem;
  }

  @media (min-width: 48rem) {
    .rec {
      width: 360px;
    }
  }

  /* Motion: one slow linear loop; it pauses on hover, while a card has focus, or via the button. */
  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .viewport {
      mask-image: linear-gradient(90deg, transparent, #000 3rem, #000 calc(100% - 3rem), transparent);
    }

    .track {
      animation: marquee 50s linear infinite;
    }

    .viewport:hover .track,
    .viewport:focus-within .track,
    .is-paused .track {
      animation-play-state: paused;
    }
  }

  /* Reduced motion: no loop. One set of cards in a row that scrolls sideways, with prev/next. */
  @media (prefers-reduced-motion: reduce) {
    .viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .rec {
      scroll-snap-align: start;
    }
  }

  .mark {
    height: 2rem;
    color: var(--accent);
    font-size: 3.5rem;
    font-weight: 600;
    line-height: 1;
  }

  .pull {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    text-wrap: balance;
  }

  blockquote {
    margin: 0.75rem 0 0;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  /* Four lines on the card; the dialog shows all of it. The full text is always in the page. */
  .text p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    white-space: pre-line;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .initials {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .who-text {
    min-width: 0;
  }

  .name {
    font-weight: 600;
    line-height: 1.3;
  }

  .title,
  .meta {
    color: var(--ink-2);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .meta time {
    white-space: nowrap;
  }

  /* The whole card is the button. */
  .open {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: inherit;
    background: none;
    cursor: pointer;
  }

  .open:focus-visible {
    outline-offset: -3px;
  }

  .rec:hover {
    border-color: var(--line-strong);
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .buttons {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    visibility: hidden;
  }

  :global(.marquee-ready) .buttons {
    visibility: visible;
  }

  .pause {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    cursor: pointer;
  }

  .pause[aria-pressed='true'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .when-paused,
  .pause[aria-pressed='true'] .when-playing {
    display: none;
  }

  .pause[aria-pressed='true'] .when-paused {
    display: inline-flex;
  }

  .when-playing,
  .when-paused {
    align-items: center;
    gap: 0.375rem;
  }

  .when-playing {
    display: inline-flex;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .arrow :global(svg) {
    transform: rotate(90deg);
  }

  .arrow.next :global(svg) {
    transform: rotate(-90deg);
  }

  .pause:hover,
  .arrow:hover {
    border-color: var(--ink-2);
  }

  .more-link {
    font-weight: 500;
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }

  /* The full recommendation. */
  .rec-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(85vh, 44rem);
    padding: clamp(1.5rem, 5vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    box-shadow: var(--shadow);
  }

  .rec-dialog::backdrop {
    background: rgb(0 0 0 / 0.55);
  }

  .rec-dialog .text p {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
  }

  .rec-dialog blockquote {
    font-size: 1rem;
  }

  .rec-dialog .pull {
    padding-right: 2.5rem;
    font-size: 1.25rem;
  }

  .dialog-body {
    display: flex;
    flex-direction: column;
  }

  .close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .close:hover {
    border-color: var(--ink-2);
  }

  /* Which controls each mode shows. Last in the sheet, so they override the base rules above. */
  @media (prefers-reduced-motion: no-preference) {
    .arrow {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rec[aria-hidden='true'],
    .pause {
      display: none;
    }
  }
</style>
