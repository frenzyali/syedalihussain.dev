---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { recommendations, recommendationsUrl } from '../data/recommendations';

const initials = (name: string) =>
  name
    .split(' ')
    .filter((w) => /^[A-Z]/.test(w))
    .map((w) => w[0])
    .filter((_, i, all) => i === 0 || i === all.length - 1)
    .join('');

// Texts longer than this can run past the six-line clamp, so they get a "Read more" toggle.
const LONG = 300;
const total = recommendations.length;
---

<Section id="recommendations">
  <div class="carousel" data-carousel data-reveal role="region" aria-roledescription="carousel" aria-label="Recommendations">
    {/* A scroll-snap track: swipe or scroll with no script; carousel.js adds buttons, dots and arrow keys. */}
    <div class="track" tabindex="0" aria-label="Recommendations, scroll sideways for more">
      {
        recommendations.map((r, i) => (
          <div class="card rec" role="group" aria-roledescription="slide" aria-label={`Recommendation ${i + 1} of ${total}`}>
            <span class="mark" aria-hidden="true">
              “
            </span>
            <p class="pull" aria-hidden="true">
              {r.pull}
            </p>
            <blockquote class="text">
              <p>{r.text}</p>
            </blockquote>
            {r.text.length > LONG && (
              <details class="read">
                <summary>
                  <span class="when-closed">Read more</span>
                  <span class="when-open">Read less</span>
                </summary>
              </details>
            )}
            <footer class="who">
              <span class="initials" aria-hidden="true">
                {initials(r.name)}
              </span>
              <div class="who-text">
                <p class="name">{r.name}</p>
                <p class="title">{r.title}</p>
                <p class="meta">
                  {r.relationship} · <time datetime={r.date.iso}>{r.date.label}</time>
                </p>
              </div>
            </footer>
          </div>
        ))
      }
    </div>

    <div class="controls">
      {/* Kept invisible (but laid out, so nothing shifts) until carousel.js wires them up. */}
      <div class="nav-buttons">
        <button class="arrow" type="button" data-prev aria-label="Previous recommendation">
          <Icon name="chevron" />
        </button>
        <button class="arrow next" type="button" data-next aria-label="Next recommendation">
          <Icon name="chevron" />
        </button>
        <div class="dots">
          {
            recommendations.map((_, i) => (
              <button class="dot" type="button" data-dot aria-label={`Show recommendation ${i + 1}`}>
                <span />
              </button>
            ))
          }
        </div>
      </div>
      <a class="more-link" href={recommendationsUrl}>Read on LinkedIn <span aria-hidden="true">→</span></a>
    </div>
  </div>
</Section>

<style>
  .track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: var(--gap);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    border-radius: var(--radius);
  }

  /* With the buttons and dots in place, the scrollbar is redundant. */
  :global(.carousel-ready) .track {
    scrollbar-width: none;
  }

  :global(.carousel-ready) .track::-webkit-scrollbar {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }

  @media (min-width: 48rem) {
    .track {
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }

  .rec {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.25rem, 4vw, 2rem);
    scroll-snap-align: start;
  }

  .mark {
    height: 2.25rem;
    color: var(--accent);
    font-size: 4rem;
    font-weight: 600;
    line-height: 1;
  }

  .pull {
    margin-top: 0.5rem;
    font-size: 1.1875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    text-wrap: balance;
  }

  blockquote {
    margin: 0.875rem 0 0;
    color: var(--ink-2);
  }

  /* Six lines, then "Read more". The full text is always in the page; only the view is clamped. */
  .text p {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    line-clamp: 6;
    white-space: pre-line;
  }

  .rec:has(.read[open]) .text p {
    display: block;
    -webkit-line-clamp: unset;
    line-clamp: none;
  }

  .read {
    margin-top: 0.5rem;
  }

  .read > summary {
    display: inline-block;
    color: var(--accent);
    font-size: 0.9375rem;
    font-weight: 500;
    list-style: none;
    cursor: pointer;
  }

  .read > summary::-webkit-details-marker {
    display: none;
  }

  .read > summary:hover {
    text-decoration: underline;
  }

  .read .when-open,
  .read[open] .when-closed {
    display: none;
  }

  .read[open] .when-open {
    display: inline;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1.5rem;
  }

  .initials {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: 0.875rem;
    font-weight: 600;
  }

  .who-text {
    min-width: 0;
  }

  .name {
    font-weight: 600;
    line-height: 1.3;
  }

  .meta time {
    white-space: nowrap;
  }

  .title,
  .meta {
    color: var(--ink-2);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  /* Prev/next and dots on the left, the LinkedIn link on the right. The dots are left-aligned,
     so hiding the spare ones on wide screens moves nothing else. */
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1rem;
    margin-top: 1rem;
  }

  .nav-buttons {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    visibility: hidden;
  }

  :global(.carousel-ready) .nav-buttons {
    visibility: visible;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
  }

  .arrow :global(svg) {
    transform: rotate(90deg);
  }

  .arrow.next :global(svg) {
    transform: rotate(-90deg);
  }

  .arrow:hover:not(:disabled) {
    border-color: var(--ink-2);
  }

  .arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .dots {
    display: flex;
    margin-left: 0.375rem;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .dot[hidden] {
    display: none;
  }

  .dot span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .dot[aria-current='true'] span {
    background: var(--accent);
  }

  .more-link {
    font-weight: 500;
    text-decoration: none;
  }

  .more-link:hover {
    text-decoration: underline;
  }
</style>
