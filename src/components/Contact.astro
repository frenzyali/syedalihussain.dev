---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// "linkedin.com/in/alihussaindevops": drop the scheme, then allow line breaks after each slash.
const parts = (url: string) =>
  url
    .replace(/^https:\/\/(www\.)?/, '')
    .replace(/\/$/, '')
    .split('/');
---

<Section id="contact">
  <a class="email" href={`mailto:${site.email}`}>{site.email}</a>

  <dl class="titleblock links">
    <div>
      <dt>github</dt>
      <dd>
        <a href={site.github}>
          <Icon name="github" />
          <span>{parts(site.github).map((p, i) => (i ? [<wbr />, `/${p}`] : p))}</span>
        </a>
      </dd>
    </div>
    <div>
      <dt>linkedin</dt>
      <dd>
        <a href={site.linkedin}>
          <Icon name="linkedin" />
          <span>{parts(site.linkedin).map((p, i) => (i ? [<wbr />, `/${p}`] : p))}</span>
        </a>
      </dd>
    </div>
  </dl>
</Section>

<style>
  .email {
    display: inline-block;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.75rem, 1rem + 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    overflow-wrap: anywhere;
  }

  .email:hover {
    color: var(--accent);
  }

  .links {
    max-width: 34rem;
    margin-top: 2rem;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
  }
</style>
