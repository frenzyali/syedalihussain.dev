---
import Section from './Section.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// Display form of a profile URL ("linkedin.com/in/alihussaindevops"), split on "/" so the
// template can put a <wbr> before each slash and long URLs wrap there on phones.
const parts = (url: string) =>
  url
    .replace(/^https:\/\/(www\.)?/, '')
    .replace(/\/$/, '')
    .split('/');

const profiles = [
  { name: 'github', url: site.github },
  { name: 'linkedin', url: site.linkedin },
] as const;
---

<Section id="contact">
  <a class="email u" href={`mailto:${site.email}`}>{site.email}</a>

  <dl class="titleblock links">
    {
      profiles.map(({ name, url }) => (
        <div>
          <dt>{name}</dt>
          <dd>
            <a href={url}>
              <Icon name={name} />
              <span class="u">{parts(url).map((p, i) => (i ? [<wbr />, `/${p}`] : p))}</span>
            </a>
          </dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .email {
    display: inline-block;
    color: var(--ink);
    font-family: var(--display);
    font-size: clamp(1.75rem, 1rem + 4vw, 3.5rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }

  .email.u::before,
  .email.u::after {
    height: 2px;
  }

  .email:hover {
    color: var(--accent);
  }

  .links {
    max-width: 34rem;
    margin-top: 2rem;
  }

  .links a {
    display: inline-flex;
    text-decoration: none;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.5rem;
  }
</style>
