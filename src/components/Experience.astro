---
import Section from './Section.astro';

interface Result {
  metric: string;
  before: { value: number; label: string };
  after: { value: number; label: string };
  text: string;
}

const results: Result[] = [
  {
    metric: 'Monthly AWS bill',
    before: { value: 425, label: '~$425' },
    after: { value: 200, label: '~$200' },
    text: 'Cut the monthly AWS bill from ~$425 to ~$200 (~53%), including ~$79/month from EC2 and RDS right-sizing — beating projected savings.',
  },
  {
    metric: 'Deploy time per service',
    before: { value: 12, label: '12 min' },
    after: { value: 4, label: '4 min' },
    text: 'Cut per-service deploy time from 12 to 4 minutes with dependency and Docker layer caching.',
  },
  {
    metric: 'Recovery time',
    before: { value: 85, label: '1 h 25 min' },
    after: { value: 49, label: '49 min' },
    text: 'Cut recovery time from 1 h 25 min to 49 min with real-time replication, warm read replicas and standbys on AWS.',
  },
];

const change = (r: Result) => `−${Math.round((1 - r.after.value / r.before.value) * 100)}%`;
const share = (r: Result) => `${((r.after.value / r.before.value) * 100).toFixed(1)}%`;
---

<Section id="experience" title="Experience">
  <ol class="jobs" role="list">
    <li>
      <article class="job">
        <header>
          <h3>AIIT Solutions</h3>
          <p class="role">DevOps Engineer, Rawalpindi</p>
          <p class="dates"><time datetime="2026-01">Jan 2026</time> – present</p>
        </header>
        <p class="lead">
          I own infrastructure, security and releases for HR360HUB, a multi-service Laravel HRMS SaaS
          on AWS with dev, UAT and production environments.
        </p>

        <ul class="results" role="list">
          {
            results.map((r) => (
              <li class="result">
                <div class="result-head" aria-hidden="true">
                  <span class="metric">{r.metric}</span>
                  <span class="change">{change(r)}</span>
                </div>
                <div class="bars" aria-hidden="true">
                  <span class="key">before</span>
                  <span class="value">{r.before.label}</span>
                  <svg class="bar before" width="100%" height="10">
                    <rect width="100%" height="10" rx="2" />
                  </svg>
                  <span class="key">after</span>
                  <span class="value">{r.after.label}</span>
                  <svg class="bar after" width="100%" height="10">
                    <rect width={share(r)} height="10" rx="2" />
                  </svg>
                </div>
                <p>{r.text}</p>
              </li>
            ))
          }
        </ul>

        <ul class="points">
          <li>
            Replaced cron-driven <span class="tool">git pull</span> builds, which ran no tests, with CI/CD on <span class="tool">GitHub Actions</span>. Dockerized the stack and trained the developers on <span class="tool">Docker</span>.
          </li>
          <li>
            Set up monitoring and alerting with <span class="tool">CloudWatch</span> and <span class="tool">SNS</span>, <span class="tool">Prometheus</span>, <span class="tool">Grafana</span> and <span class="tool">Loki</span>.
          </li>
          <li>
            Run the on-prem side: <span class="tool">Hyper-V</span>, <span class="tool">Nginx</span>, <span class="tool">MikroTik</span> networking with dual-WAN failover, and <span class="tool">Active Directory</span>.
          </li>
        </ul>
      </article>
    </li>

    <li>
      <article class="job">
        <header>
          <h3>Cloudlem</h3>
          <p class="role">Internship</p>
          <p class="dates">
            <time datetime="2025-11">Nov 2025</time> – <time datetime="2025-12">Dec 2025</time>
          </p>
        </header>
        <p>Worked on CI/CD pipeline reliability and Linux file permissions.</p>
      </article>
    </li>

    <li>
      <article class="job">
        <header>
          <h3>Al Nafi</h3>
          <p class="role">Internship</p>
          <p class="dates">
            <time datetime="2024-07">Jul 2024</time> – <time datetime="2025-07">Jul 2025</time>
          </p>
        </header>
        <p>
          Worked with <span class="tool">AWS</span>, <span class="tool">Terraform</span>, <span class="tool">Kubernetes</span> on <span class="tool">EKS</span>, and <span class="tool">Prometheus</span> and <span class="tool">Grafana</span>.
        </p>
      </article>
    </li>
  </ol>
</Section>

<style>
  .jobs {
    display: grid;
    gap: 3rem;
  }

  .job {
    max-width: 46rem;
  }

  header {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 1rem;
    align-items: baseline;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .role {
    grid-row: 2;
    color: var(--ink-2);
  }

  .dates {
    grid-row: 1;
    grid-column: 2;
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .job > p {
    max-width: var(--measure);
    margin-top: 1rem;
  }

  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .results {
    display: grid;
    gap: 1.75rem;
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--surface);
  }

  .result-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .metric {
    font-weight: 600;
  }

  .change {
    color: var(--accent);
    font-family: var(--mono);
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .bars {
    display: grid;
    grid-template-columns: 6ch 10ch minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem 0.75rem;
    margin-top: 0.75rem;
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .key {
    color: var(--ink-2);
  }

  .value {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .bar.before rect {
    fill: var(--bar-before);
  }

  .bar.after rect {
    fill: var(--bar-after);
  }

  .result p {
    max-width: var(--measure);
    margin-top: 0.75rem;
    color: var(--ink-2);
  }

  .points {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
    margin-top: 2rem;
    padding-left: 1.25rem;
  }

  .points li::marker {
    color: var(--ink-2);
  }

  @media (max-width: 30rem) {
    header {
      grid-template-columns: 1fr;
    }

    .dates {
      grid-row: 3;
      grid-column: 1;
      margin-top: 0.25rem;
    }

    .results {
      padding: 1rem;
    }
  }
</style>
