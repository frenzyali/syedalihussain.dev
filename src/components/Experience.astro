---
import Section from './Section.astro';
import OrgBadge from './OrgBadge.astro';
import Icon from './Icon.astro';
import Rich from './Rich.astro';
import { aiit, internships } from '../data/experience';

// Logo files expected in public/img/logos/, and the initials shown until they exist.
const badges: Record<string, { initials: string; logo: string }> = {
  'AIIT Solutions': { initials: 'AIIT', logo: 'aiit' },
  'Cloudlem (Pvt.) Ltd': { initials: 'CL', logo: 'cloudlem' },
  'Al Nafi International College': { initials: 'AN', logo: 'alnafi' },
};

// Internships show their first two points; the rest sit behind "Show more".
const jobs = internships.map((job) => ({ ...job, shown: job.points.slice(0, 2), rest: job.points.slice(2) }));
---

<Section id="experience">
  <ol class="card timeline" role="list">
    <li class="job" data-reveal>
      <span class="node current" aria-hidden="true"></span>
      <header class="job-head">
        <OrgBadge {...badges[aiit.org]} />
        <div class="titles">
          <h3>{aiit.role}</h3>
          <p class="org">{aiit.org}</p>
        </div>
        <p class="meta">
          <span class="pill"><span><time datetime={aiit.start.iso}>{aiit.start.label}</time> – present</span></span>
          <span class="where">{aiit.location}</span>
        </p>
      </header>
      <p class="lead">{aiit.lead}</p>

      <h4 class="label">Results</h4>
      <ul class="results" role="list">
        {
          aiit.results.map((r) => (
            <li>
              <span class="tick" aria-hidden="true" />
              {r.text}
            </li>
          ))
        }
      </ul>

      <details class="more">
        <summary>
          <span class="when-closed">Show {aiit.points.length} more</span><span class="when-open">Show less</span>
          <Icon name="chevron" />
        </summary>
        <ul class="points" role="list">
          {
            aiit.points.map((p) => (
              <li>
                <Rich text={p} />
              </li>
            ))
          }
        </ul>
      </details>
    </li>

    {
      jobs.map((job) => (
        <li class="job" data-reveal>
          <span class="node" aria-hidden="true" />
          <header class="job-head">
            <OrgBadge {...badges[job.org]} />
            <div class="titles">
              <h3>{job.role}</h3>
              <p class="org">{job.org}</p>
            </div>
            <p class="meta">
              <span class="pill">
                <span>
                  <time datetime={job.start.iso}>{job.start.label}</time> –{' '}
                  <time datetime={job.end.iso}>{job.end.label}</time>
                </span>
              </span>
              <span class="where">{job.location}</span>
            </p>
          </header>
          {'note' in job && <p class="note">{job.note}</p>}
          <ul class="points shown" role="list">
            {job.shown.map((p) => (
              <li>
                <Rich text={p} />
              </li>
            ))}
          </ul>
          {job.rest.length > 0 && (
            <details class="more">
              <summary>
                <span class="when-closed">Show {job.rest.length} more</span>
                <span class="when-open">Show less</span>
                <Icon name="chevron" />
              </summary>
              <ul class="points" role="list">
                {job.rest.map((p) => (
                  <li>
                    <Rich text={p} />
                  </li>
                ))}
              </ul>
            </details>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* One card holding a vertical rail; each job hangs off it with a node. */
  .timeline {
    position: relative;
    padding: clamp(1.25rem, 4vw, 2.5rem) clamp(1rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2.5rem)
      calc(clamp(1rem, 4vw, 2.5rem) + 1.75rem);
  }

  .timeline::before {
    content: '';
    position: absolute;
    top: clamp(1.25rem, 4vw, 2.5rem);
    bottom: clamp(1.25rem, 4vw, 2.5rem);
    left: calc(clamp(1rem, 4vw, 2.5rem) + 0.3125rem);
    width: 1px;
    background: var(--line);
  }

  .job {
    position: relative;
  }

  .job + .job {
    margin-top: 2.25rem;
    padding-top: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .node {
    position: absolute;
    top: 0.875rem;
    left: calc(-1.75rem + 0.3125rem - 5px);
    width: 11px;
    height: 11px;
    border: 2px solid var(--line-strong);
    border-radius: 50%;
    background: var(--surface);
  }

  .job + .job .node {
    top: calc(2.25rem + 0.875rem);
  }

  .node.current {
    border-color: var(--accent);
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }

  .job-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem 0.875rem;
  }

  h3 {
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }

  .org {
    color: var(--ink-2);
  }

  .meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
  }

  .where {
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  @media (min-width: 48rem) {
    .job-head {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }

    .meta {
      grid-column: 3;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.25rem;
    }
  }

  .lead {
    max-width: var(--measure);
    margin-top: 1.25rem;
    font-size: 1.0625rem;
  }

  .label {
    margin-top: 1.5rem;
    color: var(--ink-2);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .results {
    display: grid;
    gap: 0.5rem;
    max-width: var(--measure);
    margin-top: 0.625rem;
  }

  .results li {
    position: relative;
    padding-left: 1.625rem;
  }

  /* A check mark drawn with two borders. */
  .tick {
    position: absolute;
    top: 0.3em;
    left: 0.125rem;
    width: 0.5rem;
    height: 0.875rem;
    border: solid var(--ok);
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }

  .note {
    margin-top: 0.75rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .shown {
    margin-top: 1rem;
  }

  .points {
    display: grid;
    gap: 0.5rem;
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .points li {
    position: relative;
    padding-left: 1.25rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    top: 0.65em;
    left: 0.25rem;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--line-strong);
  }
</style>
