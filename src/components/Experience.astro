---
import Section from './Section.astro';
import Rich from './Rich.astro';
import { aiit, internships, change, share, ticks } from '../data/experience';
---

<Section id="experience">
  <ol class="rail" role="list">
    <li class="entry">
      <header class="entry-head">
        <h3>{aiit.org}</h3>
        <p class="entry-sub">{aiit.role}, {aiit.location}</p>
        <p class="dates"><time datetime={aiit.start.iso}>{aiit.start.label}</time> – present</p>
      </header>
      <p class="lead">{aiit.lead}</p>

      <ul class="dash" role="list">
        {
          aiit.results!.map((r) => (
            <li class="panel">
              <div class="panel-head">
                <span class="status">
                  <span class="dot" aria-hidden="true" />
                  improved
                </span>
                <span class="metric">{r.metric}</span>
                <span class="delta">{change(r)}</span>
              </div>
              <p class="reading" aria-hidden="true">
                <span class="now">{r.after.label}</span>
                <span class="was">was {r.before.label}</span>
              </p>
              <div class="chart" aria-hidden="true">
                <span class="k">before</span>
                <svg class="bar before" width="100%" height="8">
                  <rect width="100%" height="8" rx="1" />
                </svg>
                <span class="k">after</span>
                <svg class="bar after grow" width="100%" height="8">
                  <rect width={share(r)} height="8" rx="1" />
                </svg>
                <span class="k">{r.unit}</span>
                <svg class="axis" width="100%" height="22">
                  <line x1="0" x2="100%" y1="0.5" y2="0.5" />
                  {ticks(r).map((t, i) => (
                    <g>
                      <line x1={t.at} x2={t.at} y1="0" y2="5" />
                      <text x={t.at} y="18" text-anchor={i === 0 ? 'start' : 'middle'}>
                        {t.value}
                      </text>
                    </g>
                  ))}
                </svg>
              </div>
              <p class="note">{r.text}</p>
            </li>
          ))
        }
      </ul>

      <ul class="points" role="list">
        {
          aiit.points.map((p) => (
            <li>
              <Rich text={p} />
            </li>
          ))
        }
      </ul>
    </li>

    {
      internships.map((job) => (
        <li class="entry minor">
          <header class="entry-head">
            <h3>{job.org}</h3>
            <p class="entry-sub">{job.role}</p>
            <p class="dates">
              <time datetime={job.start.iso}>{job.start.label}</time> –{' '}
              <time datetime={job.end!.iso}>{job.end!.label}</time>
            </p>
          </header>
          {job.points.map((p) => (
            <p class="body">
              <Rich text={p} />
            </p>
          ))}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  /* Results as a monitoring dashboard. */
  .dash {
    display: grid;
    gap: 1px;
    margin-top: 2rem;
    border: 1px solid var(--rule);
    background: var(--rule);
  }

  @media (min-width: 64rem) {
    .dash {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .panel {
    display: flex;
    flex-direction: column;
    padding: 1rem 1.125rem 1.25rem;
    background: var(--surface);
    transition: background-color 150ms ease;
  }

  .panel:hover {
    background: color-mix(in srgb, var(--surface) 92%, var(--accent));
  }

  .panel-head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.25rem 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px dashed var(--rule);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--ok);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 22%, transparent);
  }

  .metric {
    grid-row: 2;
    font-weight: 600;
  }

  .delta {
    grid-row: 1 / 3;
    grid-column: 2;
    align-self: center;
    color: var(--accent);
    font-size: var(--step-1);
    font-weight: 600;
  }

  .reading {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 1rem;
  }

  .now {
    font-family: var(--display);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1;
  }

  .was {
    color: var(--ink-2);
    font-family: var(--mono);
    font-size: var(--step--1);
  }

  .chart {
    display: grid;
    grid-template-columns: 3.25rem minmax(0, 1fr);
    align-items: center;
    gap: 0.375rem 0.5rem;
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.75rem;
  }

  .k {
    color: var(--ink-2);
  }

  .bar.before rect {
    fill: var(--bar-before);
  }

  .bar.after rect {
    fill: var(--bar-after);
  }

  .axis {
    overflow: visible;
  }

  .axis line {
    stroke: var(--ink-2);
    stroke-width: 1;
  }

  .axis text {
    fill: var(--ink-2);
    font-family: var(--mono);
    font-size: 10px;
  }

  .note {
    margin-top: 1rem;
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .points {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
    margin-top: 2rem;
  }

  .points li {
    position: relative;
    padding-left: 1.25rem;
  }

  .points li::before {
    content: '';
    position: absolute;
    top: 0.6em;
    left: 0;
    width: 7px;
    height: 7px;
    border: 1px solid var(--accent);
  }
</style>
