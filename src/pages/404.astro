---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import Link from '../components/Link.astro';
---

<Base title={`Page not found | ${site.name}`} noindex>
  <section class="wrap missing" aria-labelledby="missing-title">
    <div class="card panel">
      <p class="code">404</p>
      <h1 id="missing-title">There's no page at this address.</h1>
      <p class="hint">This site is a single page. Everything is on the homepage.</p>
      <Link class="btn primary" href="/">Go to the homepage</Link>
    </div>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(2rem, 8vw, 5rem);
  }

  .panel {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.5rem, 6vw, 3.5rem);
  }

  .code {
    color: var(--accent);
    font-size: clamp(4.5rem, 3rem + 8vw, 8rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.9;
  }

  h1 {
    font-size: var(--step-2);
  }

  .hint {
    max-width: var(--measure);
    color: var(--ink-2);
  }

  .btn {
    margin-top: 0.5rem;
  }
</style>
